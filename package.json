{
  "name": "cdt",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cdt/api prisma:generate",
    "db:migrate": "pnpm --filter @cdt/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @cdt/api prisma:seed",
    "db:clean": "pnpm --filter @cdt/api prisma:clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "20.x"
  }
}
